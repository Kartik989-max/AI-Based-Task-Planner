# ── Neon PostgreSQL (required) ──────────────────────────────────────────────
# Create a free DB: https://neon.tech → copy connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Free LLM (pick one provider) ──────────────────────────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your-groq-key-here

# ── Apple Reminders ───────────────────────────────────────────────────────
REMINDERS_MODE=local
REMINDERS_LIST=Guide Todoo
BRIDGE_SECRET=change-me-to-a-long-random-string
BRIDGE_API_URL=https://your-app.vercel.app

# ── Jira (optional) ───────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token

# ── Scheduler (local mode only) ───────────────────────────────────────────
TIMEZONE=Asia/Kolkata
MORNING_PLAN_HOUR=8
EOD_SUMMARY_HOUR=20
