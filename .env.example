# ── Neon PostgreSQL (required) ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Free LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ── Todoist (recommended — works on Mac + iPhone, different Apple IDs OK) ─
TASKS_BACKEND=todoist
TODOIST_API_TOKEN=your-todoist-api-token
TODOIST_PROJECT_NAME=Guide Todoo
REMINDERS_MODE=off

# ── Apple Reminders (optional — only if TASKS_BACKEND=reminders) ──────────
# REMINDERS_MODE=local
# REMINDERS_LIST=Guide Todoo
# BRIDGE_SECRET=change-me
# BRIDGE_API_URL=https://your-app.vercel.app

# ── Vercel cron ───────────────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string

# ── Jira (optional) ───────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token

# ── Scheduler (local dev) ─────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
MORNING_PLAN_HOUR=8
EOD_SUMMARY_HOUR=20
