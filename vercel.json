{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/sync-todoist", "schedule": "0 * * * *" },
    { "path": "/api/cron/morning", "schedule": "0 3 * * *" },
    { "path": "/api/cron/eod", "schedule": "0 14 * * *" },
    { "path": "/api/cron/monthly", "schedule": "0 15 28-31 * *" }
  ]
}
