{
  "version": 2,
  "builds": [
    { "src": "web/package.json", "use": "@vercel/next" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/_next/(.*)", "dest": "web/_next/$1" },
    { "src": "/api/cron/(.*)", "dest": "api/index.py" },
    { "src": "/webhooks/(.*)", "dest": "api/index.py" },
    {
      "src": "/(health|onboard|profile|ingest|jira|sync|plan|tasks|review|reminders|auth|progress|leetcode|calendar|brief|bridge)(.*)",
      "dest": "api/index.py"
    },
    { "src": "/(.*)", "dest": "web/$1" }
  ],
  "crons": [
    { "path": "/api/cron/sync-todoist", "schedule": "0 * * * *" },
    { "path": "/api/cron/morning", "schedule": "0 3 * * *" },
    { "path": "/api/cron/eod", "schedule": "0 14 * * *" },
    { "path": "/api/cron/weekly", "schedule": "0 15 * * 0" },
    { "path": "/api/cron/monthly", "schedule": "0 15 28-31 * *" }
  ]
}
